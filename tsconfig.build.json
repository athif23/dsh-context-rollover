{
  "extends": "./tsconfig.build-paths.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "rootDir": "src",
    "outDir": "lib",
    "declaration": true,
    "declarationDir": "lib/types",
    "declarationMap": true,
    "sourceMap": false,
    "noEmit": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2024"
  },
  "include": ["src/**/*.ts"]
}
